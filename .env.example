# ==========================================
# Packet-CRM Example Environment Variables
# ==========================================

# --------------------------
# Deployment
# --------------------------
# "prod" enables stricter startup checks (e.g. rejects the default API key).
ENV=dev

# --------------------------
# Application Features
# --------------------------
ENABLE_LOG_FETCHING=true
ENABLE_LOG_FILTER_AGENT=false
USE_MOCK_DB=true
# Path to the rules export used when USE_MOCK_DB=true.
# Defaults to src/db/mock_db.xlsx when unset.
MOCK_DB_PATH=

# --------------------------
# Live Database Configuration
# --------------------------
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# --------------------------
# Elasticsearch Configuration
# --------------------------
ES_HOST=
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PATTERN=logs-*
# Comma-separated application_name values to fetch. Empty means no app
# restriction at all. Was hardcoded to a single service, which made every
# other service's logs unreachable regardless of where the packet failed.
ES_APP_NAMES=enu-biometric
# Optional @timestamp lower bound, in days, to stop each fetch scanning the
# whole index pattern. Deliberately NOT tied to K8S_DEFAULT_SINCE_HOURS:
# Elasticsearch is the system of record and investigations routinely run long
# after the event (consumer lag, DLQ replays, checkpoint resumes), so a short
# window here would silently drop the evidence those paths exist to recover.
# Unset = unbounded.
ES_SEARCH_WINDOW_DAYS=
# Reject self-signed/untrusted TLS certs unless explicitly disabled.
ES_VERIFY_CERTS=true
ES_REQUEST_TIMEOUT_SECONDS=30
# Hard cap on documents pulled per event during Stage 1 pagination.
LOG_MAX_DOCUMENTS=50000
# Path to a local Kibana CSV export -- when set, fetch_logs() reads from
# this file instead of calling Elasticsearch (for offline testing).
# UNCHANGED by the Kubernetes log source work; this remains the ES mock.
ES_MOCK_FILE=

# --------------------------
# Kubernetes Log Source (KUBERNETES_LOGS_PLAN.md)
# --------------------------
# Ordered fallback chain. Default is Kubernetes-first, Elasticsearch as
# fallback: pod logs are the more complete source for the recent window,
# Elasticsearch covers the long tail and whatever the cluster no longer has.
# With no cluster config below, the Kubernetes leg fails fast (no namespace
# configured) and every fetch falls straight through to Elasticsearch --
# functionally identical to pre-Kubernetes-source behaviour until
# KUBECONFIG_PATH / K8S_DEFAULT_NAMESPACE are filled in.
# Values: kubernetes,elastic | elastic,kubernetes | elastic | kubernetes
LOG_SOURCE=kubernetes,elastic

# Cluster connectivity. In-cluster config is attempted first; these are the
# fallback for a remote cluster. Keep the kubeconfig OUTSIDE this repository.
KUBECONFIG_PATH=
K8S_CONTEXT=

# Which namespace/service to read. The RBAC-scoped ServiceAccount can only
# list pods within a known namespace -- it cannot list namespaces or pods
# cluster-wide -- so the namespace must always be resolved up front. Default
# pod matching is `name_contains` (client-side substring match on pod name,
# no label_selector sent), since real deployments here don't guarantee
# consistent labels. K8S_SERVICE_MAP overrides per app, e.g.
# {"enu-biometric": {"namespace": "enu", "name_contains": "enu-biometric"}}
# Set "label_selector" instead of "name_contains" to opt into server-side
# label matching for a service that does have reliable labels, e.g.
# {"enu-biometric": {"namespace": "enu", "label_selector": "app=enu-biometric"}}
K8S_DEFAULT_NAMESPACE=
K8S_DEFAULT_APP=enu-biometric
K8S_SERVICE_MAP=

# Fan-out, bounds, and timeouts.
K8S_MAX_PODS=20
K8S_MAX_BYTES_PER_POD=10485760
K8S_FETCH_CONCURRENCY=5
K8S_REQUEST_TIMEOUT_SECONDS=30
# Wall-clock budget for the whole multi-pod fetch. Kept well under
# AGENT_INVOKE_TIMEOUT_SECONDS so a slow cluster degrades to partial results
# plus a TRUNCATED gap rather than consuming the packet's entire budget.
K8S_TOTAL_FETCH_TIMEOUT_SECONDS=60
# Identifier matching and context windows.
K8S_DEFAULT_SINCE_HOURS=2
K8S_SEARCH_FIELDS=eventId,refId
K8S_CONTEXT_LINES_BEFORE=5
K8S_CONTEXT_LINES_AFTER=20
K8S_LEVEL_PARSE_WARN_THRESHOLD=0.9
K8S_SIDECAR_DENYLIST=istio-proxy,linkerd-proxy,vault-agent

# TLS. Verification defaults on; disabling it is an explicit, logged choice.
K8S_VERIFY_SSL=true
K8S_CA_CERT_PATH=

# PII redaction. Applied after identifier filtering and before anything is
# persisted, so unredacted resident data never reaches disk or S3.
# Extra patterns are regexes separated by ||| .
K8S_REDACT_ENABLED=true
K8S_REDACT_EXTRA_PATTERNS=

# Offline fixture directory for the Kubernetes source only. Strictly
# additive -- has no effect on ES_MOCK_FILE or the Elasticsearch path.
K8S_FIXTURE_DIR=

# --------------------------
# LLM Configuration
# --------------------------
# Toggle to use HuggingFace (true) or OpenAI-compatible endpoint (false)
USE_HF=false
# Toggle to use the Mistral API instead of a local/proxy OpenAI-compatible endpoint
MOCK_LLM_WITH_MISTRAL=false
# Per-request timeout for both the OpenAI-compatible and Mistral clients.
LLM_TIMEOUT_SECONDS=60

# --- Local / Proxy Configs ---
LLM_MODEL_COMPLEX=glm-5.2-fp8
LLM_BASE_URL_COMPLEX=http://localhost:8000/v1
LLM_API_KEY_COMPLEX=dummy

LLM_MODEL_SIMPLE=Qwen/Qwen3-VL-235B-A22B-Instruct-FP8
LLM_BASE_URL_SIMPLE=http://localhost:8000/v1
LLM_API_KEY_SIMPLE=dummy

# --- Mistral Configs (used when MOCK_LLM_WITH_MISTRAL=true) ---
MISTRAL_MODEL_COMPLEX=mistral-large-latest
MISTRAL_MODEL_SIMPLE=mistral-small-latest

# --- HuggingFace Fallback Configs ---
HF_TOKEN=your_huggingface_token_here
HF_MODEL_COMPLEX=THUDM/glm-4-9b-chat
HF_MODEL_SIMPLE=Qwen/Qwen3-VL-235B-A22B-Instruct-FP8

# --------------------------
# Kafka Configuration
# --------------------------
# Fetching (Kubernetes/Elasticsearch) is decoupled from LLM analysis so the
# slow LLM stage can never stall log collection: two topics, two independent
# consumer processes (src/fast_consumer.py, src/slow_consumer.py), two
# "dumb" API routes. See ARCHITECTURE.md section 3.11.
#
#   fast_consumer.py: rejections topic -> POST /fetch-logs
#     Fetches logs, persists them, republishes the payload onto the
#     analysis queue. Bounded I/O only -- scale this down, or run few pods.
#   slow_consumer.py: analysis-queue topic -> POST /analyze-rejection
#     Runs runbook_lookup then, on a miss, the LLM investigation loop.
#     Scale this OUT (many pods) to absorb LLM latency/backlog.
#
# Both share KAFKA_CONSUMER_BROKERS; everything else below is per-role so a
# single shared .env (e.g. under start.py's single-host supervisor) can
# configure them independently. In a split-pod deployment each role's own
# Deployment manifest sets only the variables it reads.

KAFKA_CONSUMER_BROKERS=localhost:9092

# --- Fast consumer (rejections -> /fetch-logs) ---
KAFKA_CONSUMER_TOPIC_NAME=rejections
KAFKA_CONSUMER_GROUP_ID=rejection-agents-group
KAFKA_CONSUMER_INTERNAL_ENDPOINT=http://localhost:8000/fetch-logs
# Budget for a single log-fetch call -- bounded I/O, not an LLM call, so this
# is deliberately much shorter than PACKET_TIMEOUT_SECONDS below.
FAST_CONSUMER_TIMEOUT_SECONDS=90
# Serves GET /health for this process alone. Optional; unset disables it
# (fine for start.py's single-host setup, where the API's own /health
# already reports both consumers' heartbeats).
CONSUMER_HEALTH_PORT=

# --- Slow consumer (analysis queue -> /analyze-rejection) ---
# Must match PACKET_ANALYSIS_TOPIC_NAME below -- that's what POST
# /fetch-logs publishes onto, and what this consumer reads from.
SLOW_CONSUMER_TOPIC_NAME=packet-analysis-queue
SLOW_CONSUMER_GROUP_ID=packet-analysis-group
SLOW_CONSUMER_ENDPOINT=http://localhost:8000/analyze-rejection
SLOW_CONSUMER_HEALTH_PORT=
# How long the slow consumer's HTTP client waits for /analyze-rejection to
# respond -- i.e. the LLM investigation budget. Same variable, same meaning
# this had before the fetch/analyze split.
PACKET_TIMEOUT_SECONDS=300

# --- Analysis queue producer (read by POST /fetch-logs in the API) ---
PACKET_ANALYSIS_TOPIC_NAME=packet-analysis-queue

# Tuning for slow, AI-driven workloads to prevent consumer rebalances.
# Limits records per poll to avoid blocking the main thread, and increases the
# timeout budget before Kafka assumes the consumer has died. Shared by both
# consumers here for convenience; override per-pod in production if the fast
# consumer's much shorter processing time warrants a smaller
# KAFKA_MAX_POLL_INTERVAL_MS than the slow consumer needs.
KAFKA_MAX_POLL_RECORDS=5
KAFKA_MAX_POLL_INTERVAL_MS=900000

# --------------------------
# Resilience & Hardening Configuration
# --------------------------
# Maximum LLM debate loops before escalating to human
MAX_INVESTIGATION_RETRIES=3

# Bounded worker pool size. Read independently by each process: each Kafka
# consumer (fast and slow alike) sizes its own worker pool from this, and the
# API sizes its agent.invoke() executor from it too -- set it per-pod in
# production, since the fast consumer, the slow consumer, and the API
# typically want very different values here.
MAX_CONCURRENT_INVESTIGATIONS=5

# How long an IN_PROGRESS status.json is trusted before being treated as stale.
MAX_IN_PROGRESS_AGE_SECONDS=1800

# Server-side budget for a single agent.invoke() call. Defaults to
# PACKET_TIMEOUT_SECONDS - 30s if unset; only set this to override that.
# AGENT_INVOKE_TIMEOUT_SECONDS=270

# How long a rule lookup is cached before being re-fetched from the DB.
RULE_CACHE_TTL_SECONDS=600

# Casebook storage mechanism: 'local' (atomic lock) or 's3'.
# 'local' uses filelock, which does NOT coordinate across pods -- running more
# than one API replica requires 's3' plus CHECKPOINT_BACKEND=postgres, and
# boot validation enforces that when API_REPLICA_COUNT > 1.
CASEBOOK_STORAGE_BACKEND=local
CASEBOOK_S3_BUCKET=
CASEBOOK_S3_PREFIX=casebooks

# Declared replica count. Only used by boot validation to reject a
# multi-replica deployment sitting on single-node storage.
API_REPLICA_COUNT=1

# LangGraph checkpoint store: 'sqlite' (local file) or 'postgres' (shared).
# A local SQLite file cannot be shared between pods, so a packet checkpointed
# by one replica cannot be resumed by another.
CHECKPOINT_BACKEND=sqlite
# Required when CHECKPOINT_BACKEND=postgres. Needs langgraph-checkpoint-postgres.
CHECKPOINT_POSTGRES_URI=
# Required when CASEBOOK_STORAGE_BACKEND=s3, or when a reduced log payload
# is too large to embed inline in the casebook. Left unset, oversized logs
# are truncated and embedded inline instead of a broken s3:// URL.
S3_LOGS_BUCKET=

# Kafka Dead Letter Queue for pipeline drops
KAFKA_DLQ_TOPIC=rejected-packets-dlq

# API Key for securing FastAPI endpoints
PACKET_CRM_API_KEY=your-secure-api-key-here

# Requests per minute per client IP. Defaults to MAX_CONCURRENT_INVESTIGATIONS
# x 20 (min 60). The old fixed limit of 10 throttled this system's own
# consumer, which forwards every packet from a single IP.
# RATE_LIMIT_PER_MINUTE=100
# Callers exempt from rate limiting -- the consumer lives here.
RATE_LIMIT_EXEMPT_CIDRS=127.0.0.0/8,::1/128
# Proxies whose X-Forwarded-For is trusted. Empty means never trust it;
# without this, behind an ingress every caller shares one rate-limit bucket.
TRUSTED_PROXY_CIDRS=

# --------------------------
# Shutdown & Health
# --------------------------
# How long in-flight investigations get to finish on SIGTERM. Keep below the
# pod's terminationGracePeriodSeconds so the drain completes before SIGKILL.
SHUTDOWN_DRAIN_SECONDS=25
# Consumer heartbeat cadence. Written by a dedicated thread, so it keeps
# ticking while the poll loop is blocked on the concurrency semaphore.
HEARTBEAT_INTERVAL_SECONDS=5

# --------------------------
# Logging & Observability
# --------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Casebooks and their log artifacts. Override for a mounted data volume.
# LOCAL_CASESHEETS_DIR=

# --------------------------
# Outcome Loop (ENHANCEMENT_PLAN.md 4.1)
# --------------------------
# Operators record whether a resolution was actually correct via
# `python3 -m src.tools.record_outcome` or POST /outcome/{event_id}, and read
# accuracy back with `python3 -m src.tools.accuracy_report`. Without those
# verdicts there is no accuracy figure, so runbooks cannot be safely promoted
# and agent regressions are invisible. No configuration needed.

# --------------------------
# Runbook Pipeline (RUNBOOK_PLAN.md)
# --------------------------
# off: normal pipeline. shadow: compare but don't serve. serve: short-circuit agents.
RUNBOOK_MODE=off
# In-process cache TTL for loaded runbooks
RUNBOOK_CACHE_TTL_SECONDS=600
# Comma-separated reason codes cleared to actually short-circuit the agents
# under RUNBOOK_MODE=serve. Empty means no per-code restriction (all served).
# Promote a code onto this list only once `accuracy_report` shows its runbook
# matching agent accuracy in shadow mode -- codes not listed keep running the
# agents and are shadow-compared, which is how they earn their place.
RUNBOOK_SERVE_ALLOWLIST=

# --------------------------
# Synthesis Contract & Confidence (ENHANCEMENT_PLAN.md 4.3, 4.4)
# --------------------------
# Below this confidence the resolution is routed to MANUAL_REVIEW instead of
# being acted on. Default 0 = disabled: a confidence score nobody has
# calibrated is worse than none, so enable this only after accuracy_report
# shows what a given confidence is actually worth.
SYNTHESIS_CONFIDENCE_THRESHOLD=0
# Highest confidence allowed when the trace carries evidence gaps. Not a
# calibrated number but a safety property: part of the window was unreadable,
# so a higher confidence is unsupported by construction.
SYNTHESIS_GAP_CONFIDENCE_CEILING=0.6

# --------------------------
# Replay Pipeline (Human-in-the-Loop)
# --------------------------
OIS_FEIGN_BASE_URL=http://10.10.79.62:31261/ois/hold/v1
ENABLE_AUTO_REPLAY=false
# Sent as an X-API-Key header on replay calls to OIS_FEIGN_BASE_URL, if set.
OIS_API_KEY=

# --------------------------
# DLT Analysis -- Phase 1 (DLT_PLAN.md section 8)
# --------------------------
# A parallel flow to the rejection pipeline: consumes a dead-letter topic,
# fingerprints the failure from its stacktrace, and writes an advisory
# casebook. Nothing here is read until the DLT consumer exists (Phase 4).

# Java package prefixes treated as application code. Frames outside these are
# framework/JDK noise and are dropped before fingerprinting -- the reference
# sample's chain holds 60+ frames, of which 9 are application frames.
DLT_APP_PACKAGES=com.uidai.,in.gov.uidai.
# How many normalised application frames enter the fingerprint. Lower groups
# more aggressively; higher splits groups that share a call path.
DLT_FINGERPRINT_FRAMES=5
# Application frames that are exception *plumbing* rather than failure sites.
# CommonErrorFactory constructs every BusinessException in the codebase, so the
# frame is identical across all Class A failures: it adds no discriminating
# power and displaces the frame that names the real failure site. Set to an
# empty value to disable the filter (this shifts every fingerprint).
DLT_BOILERPLATE_FRAMES=in.gov.uidai.common.factory.CommonErrorFactory

# --- DLT Analysis -- Phase 2 (classification and registry) ---
# JSON object of exception-FQCN prefix -> failure class (A/B/C/U). This
# EXTENDS the built-in map rather than replacing it, so adding one entry does
# not silently drop the other forty. Longest matching prefix wins.
DLT_CLASS_MAP=
# Exception types treated as business errors. Any FQCN ending in
# "BusinessException" already qualifies regardless of this setting.
DLT_BUSINESS_EXCEPTIONS=in.gov.uidai.common.exception.BusinessException
# BusinessException code -> one-line description. Relative paths resolve
# against the repo root. A missing or malformed file is a lookup miss, never
# an error -- it lowers a finding's confidence instead of dropping the packet.
DLT_REGISTRY_PATH=business_errors.csv

# --- DLT Analysis -- Phase 3 (payload identifier and case identity) ---
# Dotted path to refId inside the DLT payload, e.g. packetMetaData.refId.
# Numeric segments index into lists (events.0.refId). Unset or wrong falls
# back to a bounded breadth-first search for the keys below, so getting this
# wrong costs a config change, not a code change. Run
# `python -m src.tools.dlt_sample --analyze <corpus>` to discover the real path.
DLT_REFID_PATH=
# Keys the fallback search looks for, in priority order.
DLT_REFID_KEYS=refId,ref_id,referenceId

# --- DLT Analysis -- Phase 4 (consumers) ---
# Master switch for start.py's single-host supervisor. Off by default: a
# deployment with no dead-letter topic would otherwise start consumers that
# fail to subscribe, and the supervisor tears down everything when a child
# exits. In a split-pod deployment each role's manifest runs its own
# entrypoint and this is irrelevant.
DLT_ENABLED=false

# DLT consumer (dead-letter topic -> /fetch-dlt-logs). Bounded I/O, no LLM.
DLT_CONSUMER_TOPIC_NAME=packet-dlt
DLT_CONSUMER_GROUP_ID=dlt-analysis-group
DLT_CONSUMER_ENDPOINT=http://localhost:8000/fetch-dlt-logs
DLT_CONSUMER_TIMEOUT_SECONDS=90
DLT_HEALTH_PORT=

# DLT analysis consumer (DLT analysis queue -> /analyze-dlt). LLM-bound;
# this is the role to scale out.
DLT_ANALYSIS_TOPIC_NAME=dlt-analysis-queue
DLT_ANALYSIS_GROUP_ID=dlt-analysis-slow-group
DLT_ANALYSIS_ENDPOINT=http://localhost:8000/analyze-dlt
DLT_ANALYSIS_TIMEOUT_SECONDS=300
DLT_ANALYSIS_HEALTH_PORT=

# --- DLT Analysis -- Phase 5 (log window) ---
# The window is anchored on retry_topic-backoff-timestamp (when the LAST
# attempt failed), not kafka_original-timestamp. In the reference sample those
# are 43 hours apart, so the wrong anchor searches a stale window and returns
# nothing with no error anywhere.
DLT_LOG_LEAD_SECONDS=300
DLT_LOG_TRAIL_SECONDS=120
# Beyond this age the fetch is skipped and a LOGS_TOO_OLD gap recorded. A
# fetch certain to return nothing still costs a full Kubernetes fan-out over
# every pod in the namespace.
DLT_MAX_LOG_AGE_SECONDS=86400

# --- DLT Analysis -- Phase 7 (groups and reuse) ---
# Cases retained per fingerprint group. occurrence_count keeps counting past
# the cap; at ~400 hits/day an uncapped list would grow without bound.
DLT_GROUP_MEMBER_CAP=200
# Master switch for recommendation reuse. Even when true, a cached answer is
# NEVER served blind: logs are always fetched and corroboration always runs,
# and only the LLM call is skipped. That is what keeps the mis-cast detector
# live on every occurrence.
DLT_REUSE_ENABLED=true
