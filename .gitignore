.venv/
__pycache__/
*.pyc
.env
abd/
*.xlsx
*.csv
*.log

src/checkpoints.db

local_casesheets/
local_checkpoints/
*.db
*.db-shm
*.db-wal


# filelock artifacts
*.lock

# Captured DLT corpus (real production messages -- never commit)
tests/fixtures/dlt/corpus/

# ...but test fixture registries must be committed (DLT BusinessException registry)
!tests/fixtures/**/*.csv

# ...and so must the reason-code catalog. It is generated from the committed
# reason_codes.txt by `python -m src.tools.parse_reason_codes`, and the running
# system reads it: without it in the repo a fresh clone has no catalog, every
# lookup misses, and classification silently reverts to pre-catalog behaviour
# -- a technical code inside a BusinessException goes back to the expensive
# lane with no error anywhere to say why. Published error codes, not operator
# data, so unlike rules.csv it belongs in git.
!reason_codes.csv

# Timestamped .env backups. `.env` is ignored; its backups were not, so one
# `git add -A` would have published every secret in them.
.env.bak*
